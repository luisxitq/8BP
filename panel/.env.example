# ─── DATABASE ────────────────────────────────────────────────────────────────
# Neon Postgres — set this after creating a Neon DB in Vercel Storage
# Vercel auto-fills DATABASE_URL when you connect the Neon integration
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── ADMIN CREDENTIALS ───────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_password

# ─── JWT SECRET ──────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
JWT_SECRET=change_me_jwt_secret_at_least_32_chars

# ─── MOD SETTINGS ────────────────────────────────────────────────────────────
MOD_VERSION=1.0
ENCRYPT_KEY=JiM21rNU12eERlNmpqa3FuQks
WS_TOKEN=KJGMDKFJDHG34KD
